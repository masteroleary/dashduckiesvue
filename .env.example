# DashDuckies — environment template
#
# Copy to ".env" and fill in the real values. .env is gitignored; this file is
# not, so NEVER put a real key in here.
#
# Most of these already exist in Railway: open the project, pick the staging or
# production service, and read them off the Variables tab. The ones that don't
# come from Railway are marked "local choice".

# ---- Database ----------------------------------------------------------------
# Full Postgres connection string. Railway > Postgres > Variables > DATABASE_URL.
# Staging and production have SEPARATE databases — use the staging one for dev.
DATABASE_URL=postgres://user:password@host:5432/railway

# ---- Sessions ----------------------------------------------------------------
# Signs the login cookie. Any long random string; must match nothing else.
# Changing it signs everyone out. Generate one with:  openssl rand -base64 48
JWT_SECRET=
# How long a session lasts, in hours. 720 = 30 days. (local choice, optional)
JWT_EXPIRATION_HOURS=720

# ---- Email (SendGrid) --------------------------------------------------------
# Sends sign-in codes, contact messages and problem reports.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@dashduckies.com
SENDGRID_FROM_NAME=Dash Duckies

# ---- SMS (Twilio Verify) -----------------------------------------------------
# Sends the 6-digit code when someone signs in with a phone number.
# Account SID (starts with AC) and the Verify service SID (starts with VA) are
# always needed. For the login, use EITHER an API key (preferred — Twilio console
# > Account > API keys & tokens > Create API key: SID starts with SK, plus its
# secret) OR the account's auth token. If both are set, the API key wins.
TWILIO_ACCOUNT_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=

# ---- Image storage (Azure Blob) ----------------------------------------------
# Duck photos, sighting photos, profile pictures and forum images.
AZURE_STORAGE_CONNECTION_STRING=

# ---- Address lookup (HERE) ---------------------------------------------------
# Turns a typed address into map coordinates, and powers the address suggestions.
HERE_API_KEY=

# ---- Notifications -----------------------------------------------------------
# Comma-separated. Who hears about new members and new sightings.
ADMIN_NOTIFICATION_EMAILS=
# Comma-separated. Who hears about reported duck problems.
# Defaults to info@dashduckies.com when left blank.
REPORT_NOTIFICATION_EMAILS=

# ---- Admin seeding -----------------------------------------------------------
# On startup this account is created if missing and flagged as admin.
ADMIN_ACCOUNT_EMAIL=info@dashduckies.com

# ---- Local development only ---------------------------------------------------
# Comma-separated accounts that sign in with the code 000000 instead of waiting
# for a real text or email. Saves burning Twilio messages while developing.
#
# IMPORTANT: do NOT list an admin account here. Anyone who knows a listed phone
# number or email could sign in as that person. The code refuses to honour this
# list when NODE_ENV=production, but keep it to non-admin dev accounts anyway.
# Phones must be in +1XXXXXXXXXX form.
DEVELOPER_PHONES=
DEVELOPER_EMAILS=
